{
  "extends": ["cluster"],
  "schema": 1,
  "name": "leaf-rot",
  "description": "A corrupted map leaf makes exactly its restored span fail loudly without silent corruption.",
  "kind": "cluster",
  "daemon": {
    "cache_pages": 16384
  },
  "topology": {
    "vset_count": 1,
    "pages_per_volume": 5000
  },
  "workload": {
    "horizon": "2s",
    "think": { "min": "20us", "max": "100us" },
    "sync_share_ppm": 1000
  },
  "nemeses": {
    "kill_hosts": [{ "at": "1200ms", "host": 0 }],
    "race_restore": false,
    "rot_leaves_at": "1199ms"
  },
  "coverage": [
    { "metric": "orphan-restore", "label": "orphan restore" },
    { "metric": "guest-death", "label": "loud corrupted-span death" }
  ],
  "outcomes": [
    { "metric": "orphan-restore", "label": "restore count", "min": 1, "max": 1 },
    { "metric": "guest-death", "label": "guest death count", "min": 1, "max": 1 }
  ]
}
