{
  "extends": ["peer-stash"],
  "schema": 1,
  "name": "peer-transfer-crashes",
  "description": "Crash each recovery-closure capture, transfer, durable flush, and upload boundary.",
  "kind": "cluster",
  "topology": { "vset_count": 1 },
  "workload": { "horizon": "6s" },
  "nemeses": {
    "restart_delay": { "min": "10ms", "max": "20ms" },
    "store_outage": null,
    "fault_points": [
      "crash-primary-before-closure-capture",
      "crash-primary-after-closure-capture",
      "crash-primary-during-artifact-transfer",
      "crash-peer-after-data-flush-before-commit",
      "crash-peer-during-upload"
    ]
  },
  "coverage": [
    { "metric": "peer-fault", "fault_point": "crash-primary-before-closure-capture", "label": "primary crash before closure capture" },
    { "metric": "peer-fault", "fault_point": "crash-primary-after-closure-capture", "label": "primary crash after closure capture" },
    { "metric": "peer-fault", "fault_point": "crash-primary-during-artifact-transfer", "label": "primary crash during artifact transfer" },
    { "metric": "peer-fault", "fault_point": "crash-peer-after-data-flush-before-commit", "label": "peer crash after data flush" },
    { "metric": "peer-fault", "fault_point": "crash-peer-during-upload", "label": "peer crash during upload" }
  ],
  "outcomes": [
    { "metric": "guest-death", "label": "guest deaths", "max": 0 }
  ]
}
