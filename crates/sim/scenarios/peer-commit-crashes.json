{
  "extends": ["peer-stash"],
  "schema": 1,
  "name": "peer-commit-crashes",
  "description": "Crash peer-stash commit, acknowledgement, primary publication, and release boundaries.",
  "kind": "cluster",
  "topology": { "volume_count": 1 },
  "workload": { "horizon": "6s" },
  "nemeses": {
    "restart_delay": { "min": "10ms", "max": "20ms" },
    "store_outage": null,
    "fault_points": [
      "crash-peer-after-commit-before-ack",
      "crash-primary-after-ack-before-sync-ok",
      "crash-primary-after-sync-ok"
    ]
  },
  "coverage": [
    { "metric": "peer-fault", "fault_point": "crash-peer-after-commit-before-ack", "label": "peer crash after commit" },
    { "metric": "peer-fault", "fault_point": "crash-primary-after-ack-before-sync-ok", "label": "primary crash after ack" },
    { "metric": "peer-fault", "fault_point": "crash-primary-after-sync-ok", "label": "primary crash after sync reply" }
  ],
  "outcomes": [
    { "metric": "guest-death", "label": "guest deaths", "max": 0 }
  ]
}
