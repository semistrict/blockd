{
  "extends": ["nvme-pressure-backed"],
  "schema": 1,
  "name": "nvme-pressure-unbacked",
  "description": "Unbacked data stalls loudly at NVMe exhaustion because nothing is safely reclaimable.",
  "kind": "single-host",
  "daemon": {
    "disk_capacity_bytes": { "uniform": { "min": 81920, "max": 122880 } },
    "disk_headroom_bytes": { "uniform": { "min": 12288, "max": 24576 } }
  },
  "topology": {
    "backed_vsets": 0
  },
  "coverage": [
    { "metric": "nvme-stall", "label": "irreducible NVMe stall" }
  ],
  "outcomes": [
    { "metric": "nvme-reclaim", "label": "unsafe NVMe reclaims", "max": 0 },
    { "metric": "guest-death", "label": "guest deaths", "max": 0 }
  ]
}
