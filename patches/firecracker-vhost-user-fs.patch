+/// Copy an immutable snapshot into an unlinked per-VM file and map that file
+/// shared. Vhost-user maps the same descriptor independently, so queue writes
+/// must be shared even though writes must never modify the source snapshot.
+fn guest_memory_from_shared_copy(
+    mem_file_path: &Path,
+    mem_state: &GuestMemoryState,
+    track_dirty_pages: bool,
+    huge_pages: HugePageConfig,
+) -> Result<Vec<GuestRegionMmap>, GuestMemoryFromFileError> {
+    let regions: Vec<_> = mem_state.regions().collect();
+    let memory_size = regions
+        .iter()
+        .try_fold(0_u64, |total, (_, size)| total.checked_add(*size as u64))
+        .ok_or(MemoryError::OffsetTooLarge)?;
+    let mut source = File::open(mem_file_path)?;
+    if source.metadata()?.len() < memory_size {
+        return Err(MemoryError::OffsetTooLarge.into());
+    }
+    let mut shared = vmm_sys_util::tempfile::TempFile::new()
+        .map_err(|error| io::Error::other(error.to_string()))?
+        .into_file();
+    shared.set_len(memory_size)?;
+    let copied = io::copy(
+        &mut std::io::Read::by_ref(&mut source).take(memory_size),
+        &mut shared,
+    )?;
+    if copied != memory_size {
+        return Err(
+            io::Error::new(io::ErrorKind::UnexpectedEof, "short guest-memory snapshot").into(),
+        );
+    }
+    Ok(memory::create(
+        regions.into_iter(),
+        libc::MAP_SHARED,
+        Some(shared),
+        track_dirty_pages,
+        huge_pages.madvise_flags(),
+    )?)
+}
