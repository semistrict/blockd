+
+impl DaxWindow {
+    fn new(vm: Arc<KvmVm>, size: u64) -> Result<Arc<Self>, std::io::Error> {
+        let gpa = vm
+            .resource_allocator()
+            .past_mmio64_memory
+            .allocate(size, DAX_ALIGNMENT, AllocPolicy::FirstMatch)
+            .map_err(|error| std::io::Error::other(error.to_string()))?
+            .start();
+        match Self::map_at(vm.clone(), gpa, size, &[]) {
+            Ok(window) => Ok(window),
+            Err(error) => {
+                if let Ok(range) = RangeInclusive::new(gpa, gpa + size - 1) {
+                    let _ = vm.resource_allocator().past_mmio64_memory.free(&range);
+                }
+                Err(error)
+            }
+        }
+    }
+
+    fn restore(
+        vm: Arc<KvmVm>,
+        gpa: u64,
+        size: u64,
+        revoked_ranges: &[(u64, u64)],
+    ) -> Result<Arc<Self>, std::io::Error> {
+        Self::map_at(vm, gpa, size, revoked_ranges)
+    }
+
+    fn map_at(
+        vm: Arc<KvmVm>,
+        gpa: u64,
+        size: u64,
+        revoked_ranges: &[(u64, u64)],
+    ) -> Result<Arc<Self>, std::io::Error> {
+        let mapping = unsafe {
+            libc::mmap(
+                std::ptr::null_mut(),
+                usize::try_from(size).expect("DAX window fits usize"),
+                libc::PROT_NONE,
+                libc::MAP_PRIVATE | libc::MAP_ANONYMOUS | libc::MAP_NORESERVE,
+                -1,
+                0,
+            )
+        };
+        if mapping == libc::MAP_FAILED {
+            return Err(std::io::Error::last_os_error());
+        }
+        let hva = mapping as u64;
+        let Some(slot) = vm.next_kvm_slot(1) else {
+            unsafe {
+                libc::munmap(
+                    mapping,
+                    usize::try_from(size).expect("DAX window fits usize"),
+                );
+            }
+            return Err(std::io::Error::other("no KVM slot for DAX window"));
+        };
+        if let Err(error) = vm.set_user_memory_region(kvm_userspace_memory_region {
+            slot,
+            guest_phys_addr: gpa,
+            memory_size: size,
+            userspace_addr: hva,
+            flags: 0,
+        }) {
+            unsafe {
+                libc::munmap(
+                    mapping,
+                    usize::try_from(size).expect("DAX window fits usize"),
+                );
+            }
+            return Err(std::io::Error::other(error.to_string()));
+        }
+        let window = Arc::new(Self {
+            vm,
+            gpa,
+            size,
+            hva,
+            slot,
+            revoked_ranges: Mutex::new(Vec::new()),
+        });
+        for &(offset, len) in revoked_ranges {
+            window.revoke(offset, len)?;
+        }
+        Ok(window)
+    }
+
+    fn validate(&self, request: &VhostUserMMap) -> Result<(), std::io::Error> {
+        if request.shmid != 0
+            || request.len == 0
+            || !request.shm_offset.is_multiple_of(4096)
+            || !request.fd_offset.is_multiple_of(4096)
+            || !request.len.is_multiple_of(4096)
+            || request
+                .shm_offset
+                .checked_add(request.len)
+                .is_none_or(|end| end > self.size)
+        {
+            return Err(std::io::Error::from_raw_os_error(libc::EINVAL));
+        }
+        Ok(())
+    }
+
+    fn revoke(&self, offset: u64, len: u64) -> Result<(), std::io::Error> {
+        if len == 0 || offset.checked_add(len).is_none_or(|end| end > self.size) {
+            return Err(std::io::Error::from_raw_os_error(libc::EINVAL));
+        }
+        revoke_dax_range(self.hva + offset, len)?;
+        let mut ranges = self
+            .revoked_ranges
+            .lock()
+            .expect("poisoned DAX revocation lock");
+        ranges.push((offset, len));
+        ranges.sort_unstable_by_key(|&(offset, _)| offset);
+        let mut merged: Vec<(u64, u64)> = Vec::with_capacity(ranges.len());
+        for &(range_offset, range_len) in ranges.iter() {
+            if let Some((last_offset, last_len)) = merged.last_mut() {
+                let last_end = *last_offset + *last_len;
+                if range_offset <= last_end {
+                    *last_len = last_end.max(range_offset + range_len) - *last_offset;
+                    continue;
+                }
+            }
+            merged.push((range_offset, range_len));
+        }
+        *ranges = merged;
+        Ok(())
+    }
+
+    fn revoked_ranges(&self) -> Vec<(u64, u64)> {
+        self.revoked_ranges
+            .lock()
+            .expect("poisoned DAX revocation lock")
+            .clone()
+    }
+
+    fn allow_map(&self, offset: u64, len: u64) -> Result<(), std::io::Error> {
+        let end = offset
+            .checked_add(len)
+            .ok_or_else(|| std::io::Error::from_raw_os_error(libc::EINVAL))?;
+        if self
+            .revoked_ranges
+            .lock()
+            .expect("poisoned DAX revocation lock")
+            .iter()
+            .any(|&(revoked_offset, revoked_len)| {
+                let revoked_end = revoked_offset + revoked_len;
+                offset < revoked_end && revoked_offset < end
+            })
+        {
+            return Err(std::io::Error::from_raw_os_error(libc::EACCES));
+        }
+        Ok(())
+    }
