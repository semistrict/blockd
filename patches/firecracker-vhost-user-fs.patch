+
+fn replace_dax_range(address: u64, len: u64, prot: libc::c_int) -> Result<(), std::io::Error> {
+    let result = unsafe {
+        libc::mmap(
+            address as *mut libc::c_void,
+            usize::try_from(len).expect("mapping fits usize"),
+            prot,
+            libc::MAP_PRIVATE | libc::MAP_ANONYMOUS | libc::MAP_FIXED | libc::MAP_NORESERVE,
+            -1,
+            0,
+        )
+    };
+    if result == libc::MAP_FAILED {
+        Err(std::io::Error::last_os_error())
+    } else {
+        Ok(())
+    }
+}
+
+fn revoke_dax_range(address: u64, len: u64) -> Result<(), std::io::Error> {
+    replace_dax_range(address, len, libc::PROT_NONE)
+}
