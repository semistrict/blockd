+#[derive(Debug)]
+struct DaxWindow {
+    vm: Arc<KvmVm>,
+    gpa: u64,
+    size: u64,
+    hva: u64,
+    slot: u32,
+    revoked_ranges: Mutex<Vec<(u64, u64)>>,
