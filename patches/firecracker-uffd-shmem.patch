+/// Guest memory for the `UffdShmem` backend: a MAP_PRIVATE mapping of the
+/// page-fault handler's shared-memory file, registered for MISSING faults.
+/// Pages the handler populates in the file resolve from the shared page
+/// cache (one physical copy across every microVM restored from the same
+/// snapshot); guest writes diverge privately via copy-on-write; pages
+/// absent from the file fault out to the handler, which populates and
+/// wakes. Reclaiming the file (hole punching) makes the next guest touch
+/// fault again — the handler's refill path.
+fn guest_memory_from_uffd_shmem(
+    mem_uds_path: &Path,
+    shmem_path: &Path,
+    mem_state: &GuestMemoryState,
+    track_dirty_pages: bool,
+) -> Result<(Vec<GuestRegionMmap>, Option<Uffd>), GuestMemoryFromUffdError> {
+    let regions: Vec<_> = mem_state.regions().collect();
+    let memory_size: u64 = regions.iter().map(|&(_, size)| size as u64).sum();
+    let shmem_file = std::fs::OpenOptions::new()
+        .read(true)
+        .write(true)
+        .open(shmem_path)
+        .map_err(GuestMemoryFromUffdError::Connect)?;
+    // The handler owns the file; make sure mapping past its current end is
+    // safe (sparse tails are fine — absent pages fault to the handler).
+    let file_size = shmem_file
+        .metadata()
+        .map_err(GuestMemoryFromUffdError::Connect)?
+        .len();
+    if file_size < memory_size {
+        shmem_file
+            .set_len(memory_size)
+            .map_err(GuestMemoryFromUffdError::Connect)?;
+    }
+    let guest_memory = memory::create(
+        regions.into_iter(),
+        libc::MAP_PRIVATE,
+        Some(shmem_file),
+        track_dirty_pages,
+        libc::MADV_NORMAL,
+    )?;
+
+    let mut backend_mappings = Vec::with_capacity(guest_memory.len());
+    let mut offset = 0;
+    for mem_region in guest_memory.iter() {
+        #[allow(deprecated)]
+        backend_mappings.push(GuestRegionUffdMapping {
+            base_host_virt_addr: mem_region.as_ptr() as u64,
+            size: mem_region.size(),
+            offset,
+            page_size: HugePageConfig::None.page_size(),
+            page_size_kib: HugePageConfig::None.page_size(),
+        });
+        offset += mem_region.size() as u64;
+    }
+
+    let uffd = UffdBuilder::new()
+        .close_on_exec(true)
+        .non_blocking(true)
+        .user_mode_only(false)
+        .create()
+        .map_err(GuestMemoryFromUffdError::Create)?;
+    for mem_region in guest_memory.iter() {
+        uffd.register(mem_region.as_ptr().cast(), mem_region.size() as _)
+            .map_err(GuestMemoryFromUffdError::Register)?;
+    }
+    send_uffd_handshake(mem_uds_path, &backend_mappings, &uffd)?;
+
+    Ok((guest_memory, Some(uffd)))
+}
